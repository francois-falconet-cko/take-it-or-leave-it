{
  "name": "take-it-or-leave-it",
  "version": "1.0.0",
  "private": true,
  "description": "Front-book pricing in 30 seconds — Commercial AI Hackathon 2026",
  "scripts": {
    "dev": "next dev -p 3400",
    "build": "next build",
    "build:static": "node scripts/ensure-book.mjs && BUILD_TARGET=static next build && rm -rf dist && cp -R out dist",
    "build:standalone": "node scripts/ensure-book.mjs && BUILD_TARGET=standalone next build",
    "build:container": "docker build -t take-it-or-leave-it .",
    "start": "next start -p 3400",
    "kiosk": "next build && next start -p 3400",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts'",
    "book:compile": "node scripts/compile-acq-framework.ts",
    "book:approve": "node scripts/approve-book.ts",
    "book:refresh": "node scripts/compile-pricing-book.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3"
  },
  "type": "module"
}
